<!DOCTYPE html>
<html>
<head>
    <title>TechSavvy Shopping</title>
    <style>
        body { font-family: Arial; background: #f2f2f2; text-align: center; }
        header { background: navy; color: white; padding: 20px; }
        .product { display: inline-block; background: white; padding: 20px; margin: 10px; }
        button { background: navy; color: white; padding: 8px; border: none; }
    </style>
</head>
<body>
<header>
    <h1>TechSavvy</h1>
    <p>Online Electronics Shopping</p>
</header>
<h2>Product Categories</h2>
<p>Smartphones | Laptops | Tablets | Accessories</p>
<div class="product">
    <h3>Smartphone</h3>
    <p>Price: ₹15,000</p>
    <button onclick="addToCart(15000)">Add to Cart</button>
</div>
<div class="product">
    <h3>Laptop</h3>
    <p>Price: ₹45,000</p>
    <button onclick="addToCart(45000)">Add to Cart</button>
</div>
<div class="product">
    <h3>Tablet</h3>
    <p>Price: ₹20,000</p>
    <button onclick="addToCart(20000)">Add to Cart</button>
</div>
<h2>Shopping Cart</h2>
<p id="cart">Total: ₹0</p>
<button onclick="checkout()">Checkout</button>
<script>
    let total = 0;
    function addToCart(price) {
        total += price;
        document.getElementById("cart").innerHTML =
            "Total: ₹" + total;
    }
    function checkout() {
        alert("Order placed successfully!");
    }
</script>
</body>
</html>
