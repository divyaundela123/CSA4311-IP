<!DOCTYPE html>
<html>
<head>
    <title>StyleHub</title>
    <style>
        body { font-family: Arial; text-align: center; background: #fff0f5; }
        header { background: #8e2450; color: white; padding: 20px; }
        .item { display: inline-block; background: white; padding: 20px; margin: 10px; }
        button { background: #8e2450; color: white; padding: 8px; border: none; }
    </style>
</head>
<body>

<header>
    <h1>StyleHub</h1>
    <p>Fashion for Everyone</p>
</header>

<h2>Categories</h2>
<p>Men | Women | Kids | Footwear | Accessories</p>

<div class="item">
    <h3>Men's Shirt</h3>
    <p>₹800</p>
    <button onclick="add(800)">Add to Cart</button>
</div>

<div class="item">
    <h3>Women's Dress</h3>
    <p>₹1500</p>
    <button onclick="add(1500)">Add to Cart</button>
</div>

<div class="item">
    <h3>Kids Wear</h3>
    <p>₹600</p>
    <button onclick="add(600)">Add to Cart</button>
</div>

<h2>Shopping Cart</h2>
<p id="total">Total: ₹0</p>
<button onclick="alert('Order placed successfully!')">Checkout</button>

<script>
    let amount = 0;

    function add(price) {
        amount += price;
        document.getElementById("total").innerHTML =
            "Total: ₹" + amount;
    }
</script>

</body>
</html>
