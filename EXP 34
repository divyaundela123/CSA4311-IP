<?php
session_start();

if (isset($_POST['apply'])) {
    $name = $_POST['name'];
    $type = $_POST['type'];
    $fee = ($type == "Government Student") ? 0 : 500;

    $_SESSION['pass'] = [
        "name" => $name,
        "type" => $type,
        "fee" => $fee
    ];
    echo "Bus Pass Applied Successfully!<br>";
}
?>

