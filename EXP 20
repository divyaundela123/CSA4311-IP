<!DOCTYPE html>
<html>
<head>
    <title>BlossomGifts</title>
    <style>
        body { font-family: Arial; background: #fff0f5; text-align: center; }
        header { background: #c2185b; color: white; padding: 20px; }
        .gift { display: inline-block; background: white; padding: 20px; margin: 10px; }
        button { background: #c2185b; color: white; padding: 8px; border: none; }
    </style>
</head>
<body>

<header>
    <h1>BlossomGifts</h1>
    <p>Send Love with Beautiful Gifts</p>
</header>

<h2>Gift Categories</h2>
<p>Flowers | Cakes | Gift Baskets | Personalized Gifts</p>

<div class="gift">
    <h3>Rose Bouquet</h3>
    <p>₹500</p>
    <button onclick="add(500)">Add to Cart</button>
</div>

<div class="gift">
    <h3>Gift Basket</h3>
    <p>₹1000</p>
    <button onclick="add(1000)">Add to Cart</button>
</div>

<div class="gift">
    <h3>Birthday Cake</h3>
    <p>₹700</p>
    <button onclick="add(700)">Add to Cart</button>
</div>

<h2>Shopping Cart</h2>
<p id="total">Total: ₹0</p>

<button onclick="alert('Your gift order is confirmed!')">
    Checkout
</button>

<script>
    let total = 0;

    function add(price) {
        total += price;
        document.getElementById("total").innerHTML =
            "Total: ₹" + total;
    }
</script>

</body>
</html>
